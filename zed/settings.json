// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "mode": "subtle"
  },
  "agent_ui_font_size": 10.0,
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "auto_indent": "syntax_aware",
  "agent": {
    "default_profile": "write",
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": true,
    },
    "favorite_models": [
      {
        "provider": "openai",
        "model": "gpt-5.3-codex",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "openai",
        "model": "gpt-5-nano",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": [],
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "gemini": {
      "type": "registry",
    },
  },
  "terminal": {
    "dock": "right",
    "font_size": 8.0,
    "font_family": "Terminess Nerd Font",
  },
  "agent_buffer_font_size": 10.0,
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrains Mono",
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 8.0,
  "buffer_font_size": 8.0,
  "theme": {
    "mode": "dark",
    "light": "Gruber Blueberry Lite 🫐",
    "dark": "Gruber Banana 🍌",
  },
}
